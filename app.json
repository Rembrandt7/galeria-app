{
  "expo": {
    "name": "Mi Galería",
    "slug": "galeria-app",
    "version": "1.7.5",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Esta aplicación necesita acceso a tus fotos para mostrarlas en la galería.",
        "NSPhotoLibraryAddUsageDescription": "Esta aplicación necesita guardar fotos en tu galería."
      }
    },
    "android": {
      "package": "com.rembrant.galeriaapp",
      "versionCode": 67,
      "requestLegacyExternalStorage": true,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "ACCESS_MEDIA_LOCATION",
        "MANAGE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES",
        "CAMERA",
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "SYSTEM_ALERT_WINDOW",
        "WAKE_LOCK",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./withFastAndroidBuild",
      "expo-image",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite grabar video desde la aplicación.",
          "microphonePermission": "Permite grabar audio en los videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite acceder a tus fotos y videos para organizarlos en tu galería.",
          "savePhotosPermission": "Permite guardar imágenes en tu galería.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
